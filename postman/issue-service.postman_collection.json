            "description": "Assignees change only the status.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DEVELOPMENT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status changed\", () => pm.expect(pm.response.json().status).to.eql(\"DEVELOPMENT\"));"
                ]
              }
            }
          ]
        }
      ]
    },
