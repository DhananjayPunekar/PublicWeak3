{
  "info": {
    "name": "ITS - Issue Service",
    "description": "Milestone 3: Issue Service endpoints. Run db/03_issue_db.sql first, start issue-service, then run the requests top to bottom (Collection Runner works too).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "issueServiceUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "newIssueId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Issues - Project Owner view",
      "item": [
        {
          "name": "Create issue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{issueServiceUrl}}/api/issues",
              "host": [
                "{{issueServiceUrl}}"
              ],
              "path": [
                "api",
                "issues"
              ]
            },
            "description": "Expect 201 with 'Issue created successfully'. status defaults to TO DO, createdOn/lastUpdated to today.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"summary\": \"Login page crashes\",\n  \"type\": \"BUG\",\n  \"project\": 101,\n  \"description\": \"Clicking Login with an empty password shows a stack trace\",\n  \"priority\": \"HIGH\",\n  \"assignee\": 2,\n  \"createdBy\": 1,\n  \"tags\": \"Authentication\",\n  \"sprint\": \"Sprint 10\",\n  \"storyPoint\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Confirmation message\", () => pm.expect(pm.response.json().message).to.eql(\"Issue created successfully\"));",
                  "pm.test(\"Default status\", () => pm.expect(pm.response.json().issue.status).to.eql(\"TO DO\"));",
                  "pm.collectionVariables.set(\"newIssueId\", pm.response.json().issueId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all issues",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{issueServiceUrl}}/api/issues",
              "host": [
                "{{issueServiceUrl}}"
              ],
              "path": [
                "api",
                "issues"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get issue by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{issueServiceUrl}}/api/issues/{{newIssueId}}",
              "host": [
                "{{issueServiceUrl}}"
              ],
              "path": [
                "api",
                "issues",
                "{{newIssueId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get issues of project 101",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{issueServiceUrl}}/api/issues/project/101",
              "host": [
                "{{issueServiceUrl}}"
              ],
              "path": [
                "api",
                "issues",
                "project",
                "101"
              ]
            },
            "description": "Sample data: issues 201, 202, 207 + the new one."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update issue (owner)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{issueServiceUrl}}/api/issues/{{newIssueId}}",
              "host": [
                "{{issueServiceUrl}}"
              ],
              "path": [
                "api",
                "issues",
                "{{newIssueId}}"
              ]
            },
            "description": "Only the fields sent are changed; lastUpdated becomes today.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"MEDIUM\",\n  \"assignee\": 3,\n  \"sprint\": \"Sprint 11\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Assignee changed\", () => pm.expect(pm.response.json().assignee).to.eql(3));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
