{
  "info": {
    "name": "ITS - User Service",
    "description": "Milestone 1: User Service endpoints. Run db/01_user_db.sql first, start user-service, then run the requests top to bottom (Collection Runner works too).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "userServiceUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "newUserId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Sign up (create user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userServiceUrl}}/api/users",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Expect 201 and 'Your account is created successfully'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Owner\",\n  \"email\": \"test.owner@example.com\",\n  \"password\": \"secret123\",\n  \"profileImage\": \"https://example.com/test.png\",\n  \"role\": \"productOwner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Confirmation message\", () => pm.expect(pm.response.json().message).to.eql(\"Your account is created successfully\"));",
                  "pm.collectionVariables.set(\"newUserId\", pm.response.json().user.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (new user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userServiceUrl}}/api/users/login",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            },
            "description": "Expect 200 and the project-owner dashboard.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.owner@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Owner dashboard\", () => pm.expect(pm.response.json().dashboard).to.eql(\"/dashboard/project-owner\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (sample assignee Bob)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userServiceUrl}}/api/users/login",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            },
            "description": "Sample user from db/01_user_db.sql.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob.johnson@example.com\",\n  \"password\": \"def456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Assignee dashboard\", () => pm.expect(pm.response.json().dashboard).to.eql(\"/dashboard/assignee\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userServiceUrl}}/api/users",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Expect 200 and a list."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userServiceUrl}}/api/users/{{newUserId}}",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{newUserId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userServiceUrl}}/api/users/{{newUserId}}",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{newUserId}}"
              ]
            },
            "description": "Only the fields sent are changed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Owner Updated\",\n  \"role\": \"assignee\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Role changed\", () => pm.expect(pm.response.json().role).to.eql(\"assignee\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{userServiceUrl}}/api/users/{{newUserId}}",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{newUserId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
