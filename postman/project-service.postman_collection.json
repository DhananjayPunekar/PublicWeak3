{
  "info": {
    "name": "ITS - Project Service",
    "description": "Milestone 2: Project Service endpoints. Run db/02_project_db.sql first, start project-service, then run the requests top to bottom (Collection Runner works too).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "projectServiceUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "newProjectId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{projectServiceUrl}}/api/projects",
              "host": [
                "{{projectServiceUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            },
            "description": "Expect 201 with 'Project created successfully' and the new project ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"Project Zeta\",\n  \"productOwner\": 1,\n  \"startDate\": \"2026-01-01\",\n  \"endDate\": \"2026-12-31\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Confirmation message\", () => pm.expect(pm.response.json().message).to.eql(\"Project created successfully\"));",
                  "pm.collectionVariables.set(\"newProjectId\", pm.response.json().projectId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{projectServiceUrl}}/api/projects",
              "host": [
                "{{projectServiceUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get project by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{projectServiceUrl}}/api/projects/{{newProjectId}}",
              "host": [
                "{{projectServiceUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{newProjectId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get projects by owner (user 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{projectServiceUrl}}/api/projects/owner/1",
              "host": [
                "{{projectServiceUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "owner",
                "1"
              ]
            },
            "description": "Sample data: user 1 owns Project Alpha (101)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update project",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{projectServiceUrl}}/api/projects/{{newProjectId}}",
              "host": [
                "{{projectServiceUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{newProjectId}}"
              ]
            },
            "description": "Only the fields sent are changed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"Project Zeta v2\",\n  \"endDate\": \"2027-03-31\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Name changed\", () => pm.expect(pm.response.json().projectName).to.eql(\"Project Zeta v2\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete project",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{projectServiceUrl}}/api/projects/{{newProjectId}}",
              "host": [
                "{{projectServiceUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{newProjectId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
